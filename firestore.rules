rules_version = '2';

// FixBench security rules — the only backend protection on the Spark plan.
// Roles: owner > manager > frontdesk / technician. See docs/PLAN.md, "Security".
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && profile().active == true; }
    function role() { return profile().role; }

    function isStaff()   { return active(); }
    function isOwner()   { return active() && role() == 'owner'; }
    function isManager() { return active() && role() in ['owner', 'manager']; }
    function isDesk()    { return active() && role() in ['owner', 'manager', 'frontdesk']; }
    function isTech()    { return active() && role() == 'technician'; }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function byMe() { return request.resource.data.byUid == request.auth.uid; }

    // ---------- shop configuration ----------
    // Public branding for the sign-in page and the customer status page.
    match /settings/public {
      allow get: if true;
      allow write: if isOwner();
    }
    match /settings/shop {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // Counter documents: /counters/{year} (yearly restart) or /counters/all
    // (never restart), each { ticket, quote, invoice }.
    // Numbers can only ever go up by exactly one, one field at a time. The owner
    // may create the document with higher starting values (moving from another
    // system), but only while it does not exist yet.
    match /counters/{year} {
      function bump(k) { return request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1; }
      function startsAt(k) { return request.resource.data.get(k, 0) in [0, 1]; }
      function shapeOk() { return request.resource.data.keys().hasOnly(['ticket', 'quote', 'invoice']); }
      function nonNeg(k) {
        return !(k in request.resource.data)
          || (request.resource.data[k] is int && request.resource.data[k] >= 0);
      }

      allow read: if isStaff();
      allow create: if isStaff() && shapeOk() && (
           (startsAt('ticket') && startsAt('quote') && startsAt('invoice'))
        || (isOwner() && nonNeg('ticket') && nonNeg('quote') && nonNeg('invoice'))
      );
      allow update: if isStaff() && shapeOk() && (
           (onlyChanges(['ticket'])  && bump('ticket')  && isDesk())
        || (onlyChanges(['quote'])   && bump('quote'))
        || (onlyChanges(['invoice']) && bump('invoice') && isDesk())
      );
      allow delete: if false;
    }

    // ---------- staff ----------
    match /users/{uid} {
      // Anyone signed in can read their own record (to see "account turned off").
      allow get: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      allow write: if isOwner();
      // After a temporary password, staff set their own and clear this flag — nothing else.
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
    }

    // ---------- customers and devices ----------
    match /customers/{id} {
      allow read: if isStaff();
      allow create, update: if isDesk();
      allow delete: if isOwner();
    }

    match /devices/{id} {
      allow read: if isStaff();
      allow create, update: if isDesk();
      allow delete: if isOwner();

      // Device password / PIN. Readable by managers and the technician assigned
      // to the linked ticket. Deleted when the device is collected.
      match /secret/{doc} {
        function assignedToMe() {
          return get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.assignedTo
            == request.auth.uid;
        }
        allow read: if isManager() || (isTech() && assignedToMe());
        allow create, update: if isDesk();
        allow delete: if isStaff();
      }
    }

    // ---------- service tickets ----------
    match /tickets/{id} {
      allow read: if isStaff();
      allow create: if isDesk();
      // The ticket number never changes once issued.
      allow update: if request.resource.data.ticketNo == resource.data.ticketNo && (
           isDesk()
           // Technicians work on their own open jobs; handing over or cancelling
           // is done at the counter.
        || (isTech() && resource.data.assignedTo == request.auth.uid
            && onlyChanges(['status', 'diagnosis', 'updatedAt'])
            && !(resource.data.status in ['collected', 'cancelled'])
            && !(request.resource.data.status in ['collected', 'cancelled']))
      );
      allow delete: if isOwner();

      match /history/{entry} {
        allow read: if isStaff();
        allow create: if isStaff() && byMe();
        allow update, delete: if false;
      }
      match /notes/{note} {
        allow read: if isStaff();
        allow create: if isStaff() && byMe();
        allow update, delete: if false;
      }
    }

    // ---------- stock ----------
    // Stock always matches its history: qty only changes together with a
    // movement written in the same batch (named by lastMovementId), by exactly
    // that movement's delta, and never below zero. `low` mirrors qty <= lowStockAt.
    match /inventory/{id} {
      function next() { return request.resource.data; }
      function movementAfter(mid) {
        return getAfter(/databases/$(database)/documents/inventory/$(id)/movements/$(mid)).data;
      }
      function itemOk(d) {
        return d.qty is int && d.qty >= 0 && d.lowStockAt is int && d.lowStockAt >= 0
          && d.cost is int && d.cost >= 0 && d.price is int && d.price >= 0
          && d.low == (d.qty <= d.lowStockAt);
      }
      function sameStock() {
        return next().qty == resource.data.qty
          && next().get('lastMovementId', '') == resource.data.get('lastMovementId', '');
      }
      function stockMoved() {
        return next().lastMovementId != resource.data.get('lastMovementId', '')
          && next().qty == resource.data.qty + movementAfter(next().lastMovementId).delta;
      }

      allow read: if isStaff();
      // Opening stock arrives as the first movement (or the item starts at zero).
      allow create: if isManager() && itemOk(next())
        && (next().qty == 0 || movementAfter(next().lastMovementId).delta == next().qty);
      allow update: if itemOk(next()) && (
           // Managers edit details freely; stock changes need a movement.
           (isManager() && (sameStock() || stockMoved()))
           // Front desk only sells: stock goes down through an invoice.
        || (isDesk() && onlyChanges(['qty', 'low', 'lastMovementId', 'updatedAt']) && stockMoved()
              && movementAfter(next().lastMovementId).reason == 'sold'
              && movementAfter(next().lastMovementId).delta < 0)
      );
      // Deactivate instead of deleting, so the history stays.
      allow delete: if false;

      match /movements/{movement} {
        allow read: if isStaff();
        allow create: if isDesk() && byMe() && request.resource.data.delta is int
          && getAfter(/databases/$(database)/documents/inventory/$(id)).data.lastMovementId == movement
          && (isManager() || request.resource.data.reason == 'sold');
        allow update, delete: if false;
      }
    }

    // ---------- quotes ----------
    // Any staff member can write a quote (technicians send them from their jobs).
    match /quotes/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isStaff()
        && request.resource.data.quoteNo == resource.data.quoteNo
        && request.resource.data.ticketId == resource.data.ticketId;
      allow delete: if isOwner();
    }

    // ---------- invoices and payments ----------
    // Money always adds up: balance == total - paid, the status matches the
    // balance, and `paid` only ever rises by the amount of a payment document
    // written in the same batch (named by lastPaymentId).
    match /invoices/{id} {
      function next() { return request.resource.data; }
      function paymentAfter(pid) {
        return getAfter(/databases/$(database)/documents/invoices/$(id)/payments/$(pid)).data;
      }
      function sumsOk(d) {
        return d.total is int && d.paid is int && d.balance is int
          && d.total >= 0 && d.paid >= 0 && d.paid <= d.total
          && d.balance == d.total - d.paid
          && d.status == (d.balance == 0 ? 'paid' : (d.paid > 0 ? 'partial' : 'unpaid'));
      }

      allow read: if isDesk();
      allow create: if isDesk() && sumsOk(next())
        && (next().paid == 0 || paymentAfter(next().lastPaymentId).amount == next().paid);
      allow update: if resource.data.status != 'void' && (
           // Taking a payment: only the money fields change, by exactly one new payment.
           (isDesk()
              && onlyChanges(['paid', 'balance', 'status', 'updatedAt', 'lastPaymentId'])
              && next().lastPaymentId != resource.data.get('lastPaymentId', '')
              && next().paid == resource.data.paid + paymentAfter(next().lastPaymentId).amount
              && sumsOk(next()))
           // Managers may correct an open invoice's lines and totals, never its
           // number or what has been paid, and never void it.
        || (isManager()
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['invoiceNo', 'paid', 'lastPaymentId', 'customerId', 'ticketId'])
              && sumsOk(next()))
           // Only the owner voids, and a void is final.
        || (isOwner() && next().status == 'void'
              && onlyChanges(['status', 'voidReason', 'voidedAt', 'voidedBy', 'updatedAt']))
      );
      // Invoices are never deleted, so the numbering has no gaps.
      allow delete: if false;

      match /payments/{payment} {
        allow read: if isDesk();
        // A payment must be the one the invoice update in the same batch points to.
        allow create: if isDesk() && byMe()
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && getAfter(/databases/$(database)/documents/invoices/$(id)).data.lastPaymentId == payment;
        allow update, delete: if false;
      }
    }

    // "Taken today" on the dashboard reads payments across invoices.
    match /{path=**}/payments/{payment} {
      allow read: if isDesk();
    }

    // Reports and "Export all data" read these across all their parents.
    match /{path=**}/history/{entry} {
      allow read: if isStaff();
    }
    match /{path=**}/notes/{note} {
      allow read: if isStaff();
    }
    match /{path=**}/movements/{movement} {
      allow read: if isStaff();
    }

    // ---------- public job status (QR code on the receipt) ----------
    match /publicStatus/{token} {
      allow get: if true;     // one document by its unguessable token
      allow list: if false;   // nobody can browse other customers' jobs
      allow write: if isStaff();
    }
  }
}
